`timescale 1ns/1ps

module demux1x4_tb;

reg I;
reg S0, S1;
wire Y0, Y1, Y2, Y3;

demux1x4 uut(
    .I(I),
    .S0(S0),
    .S1(S1),
    .Y0(Y0),
    .Y1(Y1),
    .Y2(Y2),
    .Y3(Y3)
);

initial
begin
    $display("Time\tS1 S0\tI\tY3 Y2 Y1 Y0");
    $monitor("%0t\t%b  %b\t%b\t%b  %b  %b  %b",
             $time,S1,S0,I,Y3,Y2,Y1,Y0);

    I = 1;

    S1 = 0; S0 = 0; #10;
    S1 = 0; S0 = 1; #10;
    S1 = 1; S0 = 0; #10;
    S1 = 1; S0 = 1; #10;

    I = 0;

    S1 = 0; S0 = 0; #10;
    S1 = 0; S0 = 1; #10;
    S1 = 1; S0 = 0; #10;
    S1 = 1; S0 = 1; #10;

    $finish;
end

endmodule